{
    "name": "angular",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "pnpm -w sync:assets && ng serve",
        "build": "pnpm -w sync:assets && ng build",
        "watch": "pnpm -w sync:assets && ng build --watch --configuration development",
        "test": "ng test",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "serve:prod": "npx --yes serve dist/angular/browser -l 4173",
        "lighthouse": "npx --yes lighthouse http://127.0.0.1:4173 --only-categories=performance,accessibility,best-practices,seo --preset=desktop --chrome-flags=\"--headless --no-sandbox\" --output=html,json --output-path=./lighthouse-report --quiet"
    },
    "private": true,
    "packageManager": "pnpm@10.34.5",
    "dependencies": {
        "@angular/common": "^22.1.0",
        "@angular/compiler": "^22.1.0",
        "@angular/core": "^22.1.0",
        "@angular/forms": "^22.1.0",
        "@angular/platform-browser": "^22.1.0",
        "@angular/router": "^22.1.0",
        "@portfolio/data": "workspace:*",
        "@portfolio/design-system": "workspace:*",
        "@portfolio/translations": "workspace:*",
        "@portfolio/types": "workspace:*",
        "aos": "^2.3.4",
        "countup.js": "^2.10.1",
        "rxjs": "~7.8.0",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.1.3",
        "@angular/cli": "^22.1.3",
        "@angular/compiler-cli": "^22.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/aos": "^3.0.8",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "typescript": "~6.0.2",
        "vitest": "^4.0.8"
    }
}